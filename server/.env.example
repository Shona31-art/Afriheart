# Copy to .env.local. Everything is optional for local development:
# with nothing set, Afriheart stores data in .data/common.json and uses the offline companion.

# Required in production: 32+ random characters (e.g. `openssl rand -base64 48`).
SESSION_SECRET=

# Public URL, used in share links and nudges (e.g. https://common.example.com).
NEXT_PUBLIC_APP_URL=

# Leave unset in production: without Supabase the app refuses to start, rather than
# saving to a local file that hosting wipes. "yes" = allow the local file anyway
# (a single server with a persistent disk, or running the browser tests on `next start`).
ALLOW_LOCAL_STORE=

# The Afriheart team: phone numbers (comma separated) who can open /team to check
# verification selfies and review reports.
TEAM_PHONES=

# Supabase: set both to store data in Postgres instead of the local JSON file.
# The service-role key is used only on the server. Never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI companion. Without a key, proposals come from the offline Durban guide.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# City time zone for parsing and displaying times.
NEXT_PUBLIC_CITY_TZ=Africa/Johannesburg

# Calls: optional TURN relay for strict mobile networks (comma-separated URLs).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Android app: ring phones and pop up messages when the app is closed (Firebase, free).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_ANDROID_APP=
NEXT_PUBLIC_ANDROID_APK_URL=

# Local development only: where uploaded photos and voice notes go without Supabase.
LOCAL_MEDIA_DIR=

# Sign-in codes: set ONE sender. Without one, production sign-in is switched off.
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
# Free option: your own Android phone sends the codes from its SIM (textbee.dev app).
# Used only when no paid sender above is set. TEXTBEE_DEVICE_ID is optional.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Free, fully yours: the "Afriheart Codes" app on a spare Android phone sends codes from its SIM.
# Any random 32+ characters; paste the same key into the app. Used only when no sender above is set.
SMS_GATEWAY_TOKEN=

# Free sign-in by WhatsApp (recommended): people send "Afriheart code 123456" to your WhatsApp
# Business number; Afriheart never replies, so it costs nothing. All three switch it on.
# WHATSAPP_NUMBER: the number in international form, e.g. 27612345678.
# WHATSAPP_VERIFY_TOKEN: any phrase; type the same into Meta's webhook settings.
# WHATSAPP_APP_SECRET: Meta app → App settings → Basic → App secret.
WHATSAPP_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# OTP_PROVIDER=test shows codes on screen (development and tests only).
OTP_PROVIDER=

# Afriheart+ payments (Payfast). Without these, the pass page says payments open soon.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# yes = Payfast sandbox (test cards). Remove for real payments.
PAYFAST_SANDBOX=
# off = no free week of Afriheart+ for new profiles.
PLUS_TRIAL=
# Local testing only: yes-insecure shows a pretend checkout. Never in production.
ALLOW_TEST_PAYMENTS=

# GIFs (GIPHY). Without a key, the GIFs tab doesn't show.
GIPHY_API_KEY=
# Local testing only: pretend GIFs.
ALLOW_TEST_GIFS=

# Super admins: always have full access to /admin (comma separated). Add the rest of the team in /admin.
SUPER_ADMIN_PHONES=
